# Porta da API
PORT=4000

# IA para redigir a ata (opcional — sem ela a aplicação usa um gerador
# determinístico baseado em template de Redação Oficial).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Transcrição com diarização.
# provider: auto | assemblyai | mock
#   auto       -> usa AssemblyAI se houver chave, senão usa o mock de demonstração
#   assemblyai -> exige ASSEMBLYAI_API_KEY
#   mock       -> transcrição de demonstração (offline)
TRANSCRIPTION_PROVIDER=auto
ASSEMBLYAI_API_KEY=
TRANSCRIPTION_LANGUAGE=pt

# Limite de upload em bytes (padrão 200 MB)
MAX_UPLOAD_BYTES=209715200
